# ── 브라우저에 노출되어도 되는 값 (Settings → API Keys) ─────────────────
# Vercel 에 넣을 때 Type 은 **Config** (Secret 이 아니다) — NEXT_PUBLIC_ 은 어차피
# 브라우저 번들에 실려 나가고, Secret 으로 두면 저장 뒤 값을 다시 못 봐 오타를 확인할 수 없다
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 비밀값. 절대 NEXT_PUBLIC_ 붙이지 말 것 ────────────────────
# 여기부터는 Vercel Type 을 **Secret** 으로 넣는다
# Settings → API Keys → service_role (또는 sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI(마이그레이션 push)용 ────────────────────────────────────
# Settings → General → Project ID
SUPABASE_PROJECT_REF=
# 프로젝트 생성 때 저장해 둔 DB 비밀번호
SUPABASE_DB_PASSWORD=
# https://supabase.com/dashboard/account/tokens 에서 발급
SUPABASE_ACCESS_TOKEN=

# 사이트 공개 주소 (SEO metadata, sitemap, 가입 메일의 돌아올 주소).
# 비워 두면 Vercel 프로덕션 도메인을 자동으로 쓴다. 운영은 https://winnertoeic.com (2026-09-20 Alan)
# robots.txt·sitemap.xml 은 이 주소가 빌드 때 박히므로 도메인을 바꾸면 **다시 배포**해야 한다
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 구글 서치 콘솔 소유 확인 코드 (URL 접두어 속성의 메타 태그 방식). DNS TXT 로 확인했으면 비워 둔다.
# 비어 있으면 태그를 그리지 않는다. 넣은 뒤에는 다시 배포해야 반영된다
GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 소유 확인 코드 (<meta name="naver-site-verification" content="여기"> 의 content 만).
# 네이버는 DNS 방식이 없어 이 태그가 유일한 길이다. 넣은 뒤 다시 배포해야 반영된다
NAVER_SITE_VERIFICATION=

# ── 관리자 웹 푸시 (npx web-push generate-vapid-keys) ─────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알리는 연락처. https 주소 또는 mailto:
VAPID_SUBJECT=https://winnertoeic.com

# ── 네이버 예약 알림 연결 코드 (/api/naver-reservations 인증) ───────────────
NAVER_WEBHOOK_SECRET=

# ── Vercel Cron 인증 (/api/cron/daily-digest) ─────────────────────────────
CRON_SECRET=

# ── 유튜브 불라방 자동 연결 (2026-09-21, /admin/live-channels) ─────────────
# 구글 클라우드의 OAuth 클라이언트(웹). YouTube Data API v3 사용 설정 + 동의 화면 범위 youtube.readonly + "게시" 상태.
# 승인된 리디렉션 URI: https://winnertoeic.com/api/youtube/callback (로컬은 http://localhost:3000/api/youtube/callback)
# 비어 있으면 연결 버튼 대신 설정 안내가 뜨고, 감지 크론은 아무것도 하지 않는다
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
