# ── 브라우저에 노출되어도 되는 값 (Settings → API Keys) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 서버 전용 비밀값. 절대 NEXT_PUBLIC_ 붙이지 말 것 ────────────────────
# Settings → API Keys → service_role (또는 sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase CLI(마이그레이션 push)용 ────────────────────────────────────
# Settings → General → Project ID
SUPABASE_PROJECT_REF=
# 프로젝트 생성 때 저장해 둔 DB 비밀번호
SUPABASE_DB_PASSWORD=
# https://supabase.com/dashboard/account/tokens 에서 발급
SUPABASE_ACCESS_TOKEN=

# 사이트 공개 주소 (SEO metadata, sitemap). 로컬 전용. Vercel 에서는 비워 두면 프로덕션 도메인을 자동으로 쓴다
NEXT_PUBLIC_SITE_URL=http://localhost:3000
